{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iris-app",
  "version": "0.3.0-alpha.1",
  "identifier": "com.pixelcrowgames.iris-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {

    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "iris-app",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../model_files/": "model_files/",
      "../core_prompts/UserPersonaPrompt.txt": "core_prompts/UserPersonaPrompt.txt"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/icon.icns",
      "icons/Iris_icon-1024px.png",
      "icons/Iris_icon-256px-win.ico"
    ]
  }
}
